# Inputs of infrastructure/scripts/bootstrap-production.sh. Copy to `.env.production-bootstrap`
# (ignored by Git), fill it in, and never commit it. Names only here; nothing below is a secret, but
# the file holds tenant and subscription identifiers, and this repository is public.

# Azure subscription and workforce tenant (they hold the resources).
SUBSCRIPTION_ID=
WORKFORCE_TENANT_ID=

# Resource group created for production. Never the dev group. The group's region is where the data
# lives; dev uses uaenorth. Confirm before the first deployment: moving it later means a rebuild.
RESOURCE_GROUP=rg-medsyn-prod
LOCATION=

# Static Web Apps region (static files only): westeurope, centralus, eastus2, westus2 or eastasia.
# dev uses eastasia, because westeurope refused new Static Web Apps in Session 11.
STATIC_WEB_APP_LOCATION=eastasia

# <owner>/<repo>
REPOSITORY=

# Entra External ID tenant, and the sign-up/sign-in user flow the production app joins.
EXTERNAL_TENANT_ID=
USER_FLOW_ID=

# Entra administrator of PostgreSQL. Prefer a group. It lives in the workforce tenant.
POSTGRES_ENTRA_ADMIN_OBJECT_ID=
POSTGRES_ENTRA_ADMIN_NAME=
POSTGRES_ENTRA_ADMIN_TYPE=Group

# Only for the `ses-secrets` stage: files holding one value each, outside the repository. They are
# read and stored in Key Vault, and never printed. Use the dedicated production sender, not dev's.
AWS_ACCESS_KEY_ID_FILE=
AWS_SECRET_ACCESS_KEY_FILE=
NOTIFICATIONS_ALLOWLIST_FILE=
SES_REGION=
SES_FROM_ADDRESS=

# Only for the `github` stage: a file with the address alert emails go to. Stored as the prod
# environment secret ALERT_EMAIL.
ALERT_EMAIL_FILE=
