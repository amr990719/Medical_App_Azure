# Environment variable NAMES only — never commit values. Copy to `.env` (gitignored) locally;
# in Azure these come from Container Apps settings / Key Vault references.

# --- docker compose (local only) ---------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
AZURITE_BLOB_PORT=

# --- Django core -------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXY_COUNT=
DEBUG=
LOG_LEVEL=
SECURE_SSL_REDIRECT=
SECURE_HSTS_PRELOAD=

# --- Database ----------------------------------------------------------------------------
DATABASE_URL=
DB_SSLMODE=
DB_CONN_MAX_AGE=
# production: entra (managed-identity access token) | password (DATABASE_PASSWORD / Key Vault)
DB_AUTH_MODE=
DATABASE_PASSWORD=

# --- Azure identity, Key Vault, Application Insights (production) -------------------------
# User-assigned managed identity client id; AZURE_TOKEN_CREDENTIALS=prod in Azure.
AZURE_CLIENT_ID=
AZURE_TOKEN_CREDENTIALS=
# Secrets missing from the environment are read here (names: django-secret-key,
# entra-client-secret, database-password).
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
# entra = authenticate ingestion with the managed identity
APPLICATIONINSIGHTS_AUTHENTICATION=
OTEL_SERVICE_NAME=

# --- Gunicorn (production image) ------------------------------------------------------------
GUNICORN_WORKERS=
GUNICORN_THREADS=
GUNICORN_TIMEOUT=

# --- Business configuration (docs/business-rules.md §10) ----------------------------------
CURRENT_FISCAL_YEAR=
MAX_BENEFICIARIES=
REQUIRE_MEMBER_PHOTO=
CHILD_NATIONAL_ID_AGE=
ENFORCE_SPOUSE_GENDER=
ENFORCE_SON_MINOR_AGE=
SON_MINOR_MAX_AGE=

# --- Feature flags -----------------------------------------------------------------------
DEV_AUTH_ENABLED=
API_DOCS_ENABLED=
OCR_ENABLED=
OCR_PROVIDER=
OCR_RATE_LIMIT=

# --- Sessions / rate limits / cache --------------------------------------------------------
SESSION_IDLE_TIMEOUT_SECONDS=
SESSION_ABSOLUTE_TIMEOUT_SECONDS=
AUTH_CALLBACK_RATE_LIMIT=
UPLOAD_RATE_LIMIT=
CACHE_URL=

# --- Documents / Blob Storage --------------------------------------------------------------
BLOB_BACKEND=
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=
BLOB_CREATE_CONTAINER=
DOCUMENT_CONTENT_DELIVERY=
BLOB_SAS_TTL_SECONDS=
BLOB_CLEANUP_GRACE_HOURS=
MAX_UPLOAD_BYTES=
DOCUMENT_MAX_PIXELS=
ALLOW_PDF_DOCUMENTS=
ALLOW_HEIC=
MALWARE_SCAN_ENABLED=

# --- Azure OpenAI (OCR provider) ----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Microsoft Entra External ID (OIDC BFF) -------------------------------------------------
ENTRA_AUTHORITY=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=
ENTRA_SCOPES=
ENTRA_ADMIN_REQUIRE_MFA=
ENTRA_ISSUER=
ENTRA_JWKS_URI=
